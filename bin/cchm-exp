#!/usr/bin/env bash
# cchm-exp — cchm 自我改造沙箱
#
# 流程：在 git worktree 改實驗版架構 → 獨立 port 測試 → 通過才 merge 回主線。
# 每次 promote 前自動打 tag；rollback 用 revert commits（不改寫歷史、不用 force push）。
#
#   cchm-exp start <name>    建實驗 worktree（branch exp/<name>, port 自動分配）
#   cchm-exp test <name>     在實驗 port 拉起 router 跑煙霧測試（mimo 車道＋hh 重車道）
#   cchm-exp promote <name>  合併回主線＋重啟正式 router（先自動 tag 可退回點）
#   cchm-exp drop <name>     捨棄實驗
#   cchm-exp status          列出實驗與 port
#   cchm-exp rollback [tag]  revert 到指定 tag（無參數＝最新一個 promote 點）

set -euo pipefail

REPO="${CCHM_REPO:-$HOME/cchm}"
EXPROOT="$REPO/.exp"
SECRETS="${HERMES_SECRETS_FILE:-$HOME/.hermes/.secrets/wildwest.env}"
LOGDIR="$EXPROOT/logs"
mkdir -p "$EXPROOT" "$LOGDIR"

need_key() {
  KEY=$(grep -m1 '^WILDWEST_API_KEY=' "$SECRETS" | cut -d= -f2- | tr -d '"\r')
  [ -n "$KEY" ] || { echo "找不到 WILDWEST_API_KEY"; exit 1; }
}

port_for() { # name → 第一個沒被占用的 8793+
  local used=""
  for f in "$EXPROOT"/*.port; do [ -f "$f" ] && used="$used $(cat "$f")"; done
  local p=8793
  while echo " $used " | grep -q " $p "; do p=$((p+1)); done
  while ss -ltn | grep -q ":$p "; do p=$((p+1)); done
  echo $p
}

prod_restart() {
  pkill -f 'node .*src/router\.mjs' 2>/dev/null || true
  sleep 0.5
  (cd "$REPO" && setsid nohup node src/router.mjs > /tmp/cchm-router.log 2>&1 < /dev/null &)
  sleep 1
  ss -ltn | grep -q ':8791 ' || { echo "警告：正式 router 未起來，查 /tmp/cchm-router.log"; return 1; }
  echo "正式 router 已重啟（port 8791）"
}

smoke() { # port → 0/1：mimo 與 hh 兩車道都拿到 assistant 回應才算過
  local port=$1 ok=0
  need_key
  for M in mimo-v2.6-flash-outlaw hh-deepseek-v4.1-flash-1017; do
    R=$(curl -s --max-time 60 "http://127.0.0.1:$port/v1/messages" \
      -H "authorization: Bearer $KEY" -H 'anthropic-version: 2023-06-01' \
      -H 'content-type: application/json' \
      -d "{\"model\":\"$M\",\"max_tokens\":30,\"messages\":[{\"role\":\"user\",\"content\":\"說OK\"}]}")
    echo "$R" | grep -q '"type":"message"' && ok=$((ok+1)) || echo "  $M 失敗：$(echo "$R" | head -c 120)"
  done
  [ "$ok" -eq 2 ]
}

case "${1:-}" in
  start)
    NAME="${2:?用法: cchm-exp start <name>}"
    PORT=$(port_for)
    cd "$REPO"
    git worktree add "$EXPROOT/$NAME" -b "exp/$NAME" 2>/dev/null || { echo "worktree 已存在"; exit 1; }
    echo "$PORT" > "$EXPROOT/$NAME.port"
    echo "實驗 '$NAME' 就緒：目錄 $EXPROOT/$NAME · 分支 exp/$NAME · 測試 port $PORT"
    ;;
  test)
    NAME="${2:?用法: cchm-exp test <name>}"
    WT="$EXPROOT/$NAME"; [ -d "$WT" ] || { echo "沒有這個實驗"; exit 1; }
    PORT=$(cat "$EXPROOT/$NAME.port")
    LOG="$LOGDIR/$NAME-test.log"
    (cd "$WT" && CCHM_PORT=$PORT setsid nohup node src/router.mjs > "$LOG" 2>&1 < /dev/null &)
    sleep 1
    if smoke "$PORT"; then
      echo "PASS：兩條車道都通（port $PORT，router log: $LOG）"
      RESULT=0
    else
      echo "FAIL：煙霧測試沒過，詳見 $LOG"
      RESULT=1
    fi
    pkill -f "PORT=$PORT" 2>/dev/null || true
    ss -ltn | grep ":$PORT " && fuser -k "$PORT"/tcp 2>/dev/null || true
    exit $RESULT
    ;;
  promote)
    NAME="${2:?用法: cchm-exp promote <name>}"
    WT="$EXPROOT/$NAME"; [ -d "$WT" ] || { echo "沒有這個實驗"; exit 1; }
    cd "$WT"
    [ -n "$(git status --porcelain)" ] && { git add -A; git commit -q -m "exp/$NAME 變更"; } || true
    cd "$REPO"
    git rev-parse --verify -q refs/tags/latest >/dev/null && BASE=$(git describe --tags --abbrev=0 latest 2>/dev/null || echo "") || BASE=""
    PROMOTE_TAG="promote-$(date +%Y%m%d-%H%M%S)"
    git tag "$PROMOTE_TAG" master        # 退回錨點：merge 前的主線狀態
    git merge --no-edit -q "exp/$NAME"
    git tag -f latest "$PROMOTE_TAG"
    prod_restart && echo "已 promote：$PROMOTE_TAG（rollback: cchm-exp rollback $PROMOTE_TAG）"
    ;;
  drop)
    NAME="${2:?用法: cchm-exp drop <name>}"
    cd "$REPO"
    git worktree remove --force "$EXPROOT/$NAME" 2>/dev/null || true
    git branch -D "exp/$NAME" 2>/dev/null || true
    rm -f "$EXPROOT/$NAME.port"
    echo "實驗 '$NAME' 已捨棄"
    ;;
  status)
    cd "$REPO"
    git worktree list | sed -n '2,$p'
    echo "--- 最近退回點 ---"
    git tag --sort=-creatordate | grep '^promote-' | head -5
    ;;
  rollback)
    TAG="${2:-latest}"
    cd "$REPO"
    [ "$TAG" = "latest" ] && TAG=$(git tag --sort=-creatordate | grep '^promote-' | head -1)
    git rev-parse --verify -q "refs/tags/$TAG" >/dev/null || { echo "沒有 tag $TAG"; exit 1; }
    git revert --no-edit -q "$TAG..master" || { echo "revert 衝突，手動處理"; exit 1; }
    git tag -f latest "$TAG"
    prod_restart && echo "已退回到 $TAG 的狀態（revert commits 已建立）"
    ;;
  *)
    sed -n '2,14p' "$0"; exit 1 ;;
esac
